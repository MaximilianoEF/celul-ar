# =====================================================
# CeluAR — Variables de entorno
# Copiá este archivo como .env.local y completá los valores
# =====================================================

# ─── Supabase ─────────────────────────────────────────
# Encontrás estos valores en: supabase.com > tu proyecto > Settings > API

# URL del proyecto (ej: https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Clave anónima pública (anon public key) — segura para exponer en el frontend
VITE_SUPABASE_ANON_KEY=

# ─── Solo para el script de seed (scripts/seed-db.ts) ─
# Service role key — NUNCA la pongas en el frontend, solo en scripts de servidor
SUPABASE_SERVICE_ROLE_KEY=
