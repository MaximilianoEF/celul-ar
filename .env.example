# =====================================================
# CeluAR — Variables de entorno
# Copiá este archivo como .env.local y completá los valores
# =====================================================

# ─── Supabase ─────────────────────────────────────────
# Encontrás estos valores en: supabase.com > tu proyecto > Settings > API

# URL del proyecto (ej: https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Clave anónima pública (anon public key) — segura para exponer en el frontend
VITE_SUPABASE_ANON_KEY=

# ─── Solo para el script de seed (scripts/seed-db.ts) ─
# Service role key — NUNCA la pongas en el frontend, solo en scripts de servidor
SUPABASE_SERVICE_ROLE_KEY=

# ─── Supabase Edge Function ml-search (Supabase Secrets, NO .env.local) ───────
# Estos valores se guardan con: supabase secrets set ML_CLIENT_ID=... ML_CLIENT_SECRET=... ML_REFRESH_TOKEN=...
# NO van en .env.local — son secrets del servidor, no del frontend.
#
# Pasos para obtenerlos:
#   1. Crear app en https://developers.mercadolibre.com.ar (Redirect URI: https://httpbin.org/get)
#   2. Ir a: https://auth.mercadolibre.com.ar/authorization?response_type=code&client_id=TU_APP_ID&redirect_uri=https://httpbin.org/get
#   3. Autorizar → copiar el "code" de la URL de redirección
#   4. Canjear: curl -X POST https://api.mercadolibre.com/oauth/token \
#        -d "grant_type=authorization_code&client_id=APP_ID&client_secret=SECRET&code=CODE&redirect_uri=https://httpbin.org/get"
#   5. Copiar el "refresh_token" de la respuesta
#   6. supabase secrets set ML_CLIENT_ID=APP_ID ML_CLIENT_SECRET=SECRET ML_REFRESH_TOKEN=REFRESH_TOKEN
#
# ML_CLIENT_ID=          ← APP_ID de tu app de ML
# ML_CLIENT_SECRET=      ← Secret Key de tu app de ML
# ML_REFRESH_TOKEN=      ← refresh_token obtenido en paso 5 (dura 6 meses, se renueva solo)
